AI_GATEWAY_API_KEY=

# --- Fase 3 (Etapa 1): Supabase/Postgres para pedidos reales ---
# Variables SOLO de servidor (Vercel). Nunca deben tener el prefijo
# NEXT_PUBLIC_ ni exponerse al navegador. Se completan automaticamente al
# conectar el proyecto de Supabase como integracion de Vercel Marketplace
# (https://vercel.com/marketplace/supabase), o manualmente en Vercel ->
# Project Settings -> Environment Variables si el proyecto de Supabase ya
# existe.
#
# SUPABASE_URL / SUPABASE_SECRET_KEY: nomenclatura vigente (2026) de
# Supabase (claves "publishable"/"secret"). SUPABASE_SERVICE_ROLE_KEY
# sigue funcionando como alias legado (se lee como fallback), pero
# Supabase anuncio su deprecacion para fines de 2026: usar
# SUPABASE_SECRET_KEY en proyectos nuevos.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Alias legado, opcional (solo si el proyecto de Supabase todavia no
# migro a las claves publishable/secret nuevas). Dejar sin usar si ya se
# configuro SUPABASE_SECRET_KEY.
#SUPABASE_SERVICE_ROLE_KEY=

# --- Solo para tests de integracion opcionales (npm run test:integration) ---
# Deben apuntar a un proyecto Supabase de Preview/Test dedicado, NUNCA al
# proyecto productivo. Sin estas variables, test:integration se salta
# automaticamente y no rompe CI.
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=

# --- Fase 3 (Etapa 3): Mercado Pago Checkout Pro (SANDBOX unicamente) ---
# Variables SOLO de servidor. Nunca deben tener el prefijo NEXT_PUBLIC_
# ni exponerse al navegador (ver lib/mercadopago-client.js,
# lib/mercadopago-preference.js y lib/pedido-preferencia.js).
#
# MERCADOPAGO_ACCESS_TOKEN: access token privado de una cuenta de PRUEBA
# de Mercado Pago (nunca el de una cuenta productiva). Se usa solo como
# credencial Bearer al llamar a la API de Mercado Pago; nunca se loguea
# ni se devuelve en ninguna respuesta.
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_ENV: 'sandbox' o 'production'. Si no esta definida, o tiene
# un valor invalido, el codigo asume 'sandbox' por seguridad (ver
# lib/mercadopago-preference.js#getMercadoPagoEnv). En esta etapa
# production NUNCA se habilita, sin importar el valor de esta variable
# (ver lib/pedido-preferencia.js): dejarla vacia o en 'sandbox'.
MERCADOPAGO_ENV=

# --- Fase 3 (Etapa 4): Webhook de Mercado Pago (SANDBOX unicamente) ---
# Variable SOLO de servidor. Nunca debe tener el prefijo NEXT_PUBLIC_ ni
# exponerse al navegador. Es el secreto que usa POST /api/mercadopago-webhook
# (ver lib/mercadopago-webhook.js) para validar la firma oficial (header
# x-signature) de cada notificacion entrante: sin esta variable configurada,
# el webhook rechaza (401) absolutamente todas las notificaciones, incluso
# las legitimas, por diseno (fail closed). Nunca se loguea ni se devuelve
# en ninguna respuesta HTTP.
#
# Se obtiene en el dashboard de Mercado Pago Developers, dentro de la
# configuracion de Webhooks de la aplicacion (seccion "Firma secreta" /
# "Signature secret"), al configurar la URL de notificaciones. Esa URL
# TODAVIA NO se configuro en el dashboard en esta etapa (requiere
# autorizacion explicita nueva: ver docs/CONTINUAR-FASE3.md). Documentar
# SOLO el nombre de la variable aqui, nunca copiar ni commitear el valor
# real.
MERCADOPAGO_WEBHOOK_SECRET=

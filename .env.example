AI_GATEWAY_API_KEY=

# --- Fase 3 (Etapa 1): Supabase/Postgres para pedidos reales ---
# Variables SOLO de servidor (Vercel). Nunca deben tener el prefijo
# NEXT_PUBLIC_ ni exponerse al navegador. Se completan automaticamente al
# conectar el proyecto de Supabase como integracion de Vercel Marketplace
# (https://vercel.com/marketplace/supabase), o manualmente en Vercel ->
# Project Settings -> Environment Variables si el proyecto de Supabase ya
# existe.
#
# SUPABASE_URL / SUPABASE_SECRET_KEY: nomenclatura vigente (2026) de
# Supabase (claves "publishable"/"secret"). SUPABASE_SERVICE_ROLE_KEY
# sigue funcionando como alias legado (se lee como fallback), pero
# Supabase anuncio su deprecacion para fines de 2026: usar
# SUPABASE_SECRET_KEY en proyectos nuevos.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Alias legado, opcional (solo si el proyecto de Supabase todavia no
# migro a las claves publishable/secret nuevas). Dejar sin usar si ya se
# configuro SUPABASE_SECRET_KEY.
#SUPABASE_SERVICE_ROLE_KEY=

# --- Solo para tests de integracion opcionales (npm run test:integration) ---
# Deben apuntar a un proyecto Supabase de Preview/Test dedicado, NUNCA al
# proyecto productivo. Sin estas variables, test:integration se salta
# automaticamente y no rompe CI.
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=

# --- Fase 3 (Etapa 3): Mercado Pago Checkout Pro ---
# Variables SOLO de servidor. Nunca deben tener el prefijo NEXT_PUBLIC_
# ni exponerse al navegador (ver lib/mercadopago-client.js,
# lib/mercadopago-preference.js y lib/pedido-preferencia.js).
#
# MERCADOPAGO_ACCESS_TOKEN: access token privado de Mercado Pago. En
# sandbox, el de una cuenta de PRUEBA; en production, el de la cuenta
# real de Padel10Store. Se usa solo como credencial Bearer al llamar a la
# API de Mercado Pago; nunca se loguea ni se devuelve en ninguna
# respuesta.
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_ENV: 'sandbox' o 'production'. Si no esta definida, o tiene
# un valor invalido, el codigo asume 'sandbox' por seguridad (ver
# lib/mercadopago-preference.js#getMercadoPagoEnv).
#
# IMPORTANTE - esta variable sola NO alcanza para habilitar production:
# lib/mercadopago-preference.js#resolverEntornoMercadoPago() la cruza
# SIEMPRE con VERCEL_ENV (la variable que Vercel setea automaticamente,
# nunca configurable a mano por este proyecto). Production solo queda
# habilitado cuando, A LA VEZ, MERCADOPAGO_ENV='production' Y
# VERCEL_ENV='production' (el deployment de Production real, nunca
# Preview). Poner MERCADOPAGO_ENV=production en un proyecto de Vercel
# Preview NO habilita cobros reales: el codigo lo rechaza (fail closed) y
# el pedido queda registrado sin URL de pago. Dejarla vacia o en
# 'sandbox' en cualquier entorno que no deba cobrar de verdad.
MERCADOPAGO_ENV=

# --- Fase 3 (Etapa 4): Webhook de Mercado Pago ---
# Variable SOLO de servidor. Nunca debe tener el prefijo NEXT_PUBLIC_ ni
# exponerse al navegador. Es el secreto que usa POST /api/mercadopago-webhook
# (ver lib/mercadopago-webhook.js) para validar la firma oficial (header
# x-signature) de cada notificacion entrante: sin esta variable configurada,
# el webhook rechaza (401) absolutamente todas las notificaciones, incluso
# las legitimas, por diseno (fail closed). Nunca se loguea ni se devuelve
# en ninguna respuesta HTTP. El mismo mecanismo de firma se usa tanto en
# sandbox como en production (cada uno con su propio secreto, del
# dashboard correspondiente): esta variable no distingue entorno por si
# misma.
#
# Se obtiene en el dashboard de Mercado Pago Developers, dentro de la
# configuracion de Webhooks de la aplicacion (seccion "Firma secreta" /
# "Signature secret"), al configurar la URL de notificaciones. Documentar
# SOLO el nombre de la variable aqui, nunca copiar ni commitear el valor
# real.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Interruptor de seguridad del checkout real ---
# Variable SOLO de servidor. Nunca debe tener el prefijo NEXT_PUBLIC_ ni
# exponerse al navegador (el frontend consulta GET /api/checkout-config,
# que a su vez lee esta variable del lado servidor - nunca la expone
# directamente, solo el booleano resultante). Permite pausar la compra
# online (crear pedidos y preferencias de Mercado Pago) sin tocar codigo
# ni redeployar: por ejemplo, ante un incidente, mientras se corrige un
# problema de stock, o antes de habilitar production por primera vez.
#
# CHECKOUT_ENABLED: 'true' habilita POST /api/pedidos y
# POST /api/pedidos-preferencia. CUALQUIER otro valor -ausente, vacio,
# 'false', 'TRUE' (mayusculas), '1', o cualquier otro string- los
# deshabilita (ver lib/checkout-config.js#esCheckoutHabilitado: fail
# closed, comparacion exacta contra el string 'true', nunca normalizada).
# Con el checkout deshabilitado, esos dos endpoints responden 503 con un
# mensaje comercial, SIN tocar Supabase ni Mercado Pago; el catalogo, las
# fichas de producto, el carrito y "Consultar por WhatsApp" siguen
# funcionando siempre, con cualquier valor de esta variable.
#
# Dejarla sin definir (o en cualquier valor que no sea 'true') dejo el
# checkout deshabilitado por default: hay que configurarla explicitamente
# como CHECKOUT_ENABLED=true en Vercel (Project Settings -> Environment
# Variables) para habilitar la compra real.
CHECKOUT_ENABLED=
